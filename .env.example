# Copy to .env. NEVER commit .env. Values below are intentionally empty.
# Free tier limits change: see docs/FREE-APIS.md and re-check the vendor page.

# ---- LLM providers (router tries them in the order set in config) ----
GROQ_API_KEY=            # chat + Whisper STT. https://console.groq.com
GEMINI_API_KEY=          # vision + long context. https://aistudio.google.com
OPENROUTER_API_KEY=      # :free models. https://openrouter.ai
CEREBRAS_API_KEY=        # optional. https://cloud.cerebras.ai
NVIDIA_API_KEY=          # optional. https://build.nvidia.com
MISTRAL_API_KEY=         # optional. https://console.mistral.ai
HF_TOKEN=                # model downloads, Space deploy. https://huggingface.co/settings/tokens
OPENAI_API_KEY=          # LAST RESORT / judge only. Budget capped below.
OPENAI_BUDGET_USD=2.00   # hard cap enforced by the router (you have about $5 credit)
OMNIROUTE_BASE_URL=      # optional: OpenAI compatible gateway, e.g. http://localhost:20128/v1

# ---- Auth (demo RBAC) ----
JWT_SECRET=              # long random string, generate locally
DEMO_ADMIN_PASSWORD=     # used by scripts/seed_users.py, never committed
DEMO_DEV_PASSWORD=
DEMO_VIEWER_PASSWORD=

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- Storage ----
DATABASE_URL=sqlite:///data/app.db
QDRANT_PATH=data/index/qdrant   # embedded local mode; set QDRANT_URL/QDRANT_API_KEY for cloud
QDRANT_URL=
QDRANT_API_KEY=
